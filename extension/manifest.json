{
  "manifest_version": 3,
  "name": "Shopee Review Risk Agent",
  "version": "1.2.0",
  "description": "Crawl review Shopee, đẩy tự động sang Web UI Review Lens (http://127.0.0.1:8000) hoặc phân tích ngay với agent local.",
  "permissions": ["scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8765/*",
    "https://shopee.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
